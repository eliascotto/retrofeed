# Fixtures output directory (absolute path or relative to project root)
# Default: fixtures-output relative to lib/scrapers
FIXTURES_DIR=

# Request delay range between article fetches in milliseconds
# This is the pause/delay BETWEEN consecutive HTTP requests, used for rate limiting.
# Applied AFTER each request completes, BEFORE making the next request.
# Prevents overwhelming servers by making requests too quickly.
# A random delay between REQUEST_DELAY_MIN and REQUEST_DELAY_MAX is chosen each time
# to make the scraper's request pattern less predictable and more human-like.
# Example: REQUEST_DELAY_MIN=500 REQUEST_DELAY_MAX=3000 means each delay will be
# a random value between 500ms and 3000ms.
# Default: REQUEST_DELAY_MIN=500, REQUEST_DELAY_MAX=3000
REQUEST_DELAY_MIN=500
REQUEST_DELAY_MAX=3000

# Request timeout in milliseconds
# This is the maximum time to wait for a SINGLE HTTP request to complete before aborting.
# This is a timeout for individual requests, not a delay between requests.
# If a request takes longer than this, it will be aborted and an error thrown.
# Prevents the scraper from hanging indefinitely on slow or unresponsive servers.
# Example: REQUEST_TIMEOUT=30000 means abort any request that takes longer than 30 seconds.
# Default: 30000
REQUEST_TIMEOUT=30000

# User agent string for HTTP requests
# Default: Mozilla/5.0 (compatible; Retrofeed/1.0; +https://retrofeed.com)
USER_AGENT=

# Maximum concurrent requests (for future parallel scraping)
# Default: 1
MAX_CONCURRENT=1

# Enable verbose logging
# Default: false
VERBOSE=false

# User-agent used for scraping
RETROFEED_USER_AGENT=
