<%= render "shared/auth_form_container" do %>
  <h1 class="text-2xl mb-8 text-center text-base-content">Change Email</h1>

  <p class="text-base-content/70 text-center mb-6">
    Enter a new email address and we'll send a confirmation link.
  </p>

  <%= form_with url: edit_confirmation_path, method: :patch, local: true, data: { turbo: false } do |f| %>
    <%= render partial: "shared/auth_field", locals: { form: f, field: :email, label: "New Email", type: :email, required: true, autofocus: true, margin_bottom: 30 } %>

    <%= render partial: "shared/auth_submit_button", locals: { text: "Send Confirmation" } %>
  <% end %>

  <div class="mt-5 text-center text-sm">
    <%= link_to "Back", new_confirmation_path, class: "link link-hover text-base-content" %>
  </div>
<% end %>
