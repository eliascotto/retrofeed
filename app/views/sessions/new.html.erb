<!-- Login page -->
<% footer = capture do %>
  <div class="mt-5 text-center text-sm">
    <%= link_to "Forgot your password?", new_password_reset_path, class: "link link-hover underline text-base-content" %>
  </div>

  <div class="mt-5 text-center text-sm">
    Don't have an account? <%= link_to "Sign up", new_user_path, class: "link link-hover underline text-base-content" %>
  </div>
<% end %>

<%= render "shared/auth_card", title: "Login to Retrofeed", footer: footer do %>
  <!-- Notice box -->
  <% if flash[:notice].present? %>
    <div class="p-3 rounded-lg bg-primary/70">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <%= form_with url: sessions_path, method: :post, local: true, data: { turbo: false } do |f| %>
    <%= render partial: "shared/auth_field", locals: { form: f, field: :email, label: "Email", type: :email, required: true, autofocus: true } %>

    <%= render partial: "shared/auth_field", locals: { form: f, field: :password, label: "Password", type: :password, required: true, margin_bottom: 30 } %>

    <%= render partial: "shared/auth_submit_button", locals: { text: "Log in" } %>
  <% end %>
<% end %>
