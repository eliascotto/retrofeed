<head>
  <title><%= content_for(:title) || "RetroFeed" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="application-name" content="Retrofeed">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="color-scheme" content="light dark">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%# Inline theme bootstrap must run before paint to prevent FOUC.
      `javascript_tag` automatically receives the CSP nonce (see
      content_security_policy initializer with nonce_directives = script-src). %>
  <%= javascript_tag nonce: true do %>
    // Set DaisyUI theme based on localStorage preference or system preference.
    // Settings are stored in localStorage under 'retrofeed_settings' key.
    (function() {
      var settings = {};
      try {
        var stored = localStorage.getItem('retrofeed_settings');
        if (stored) settings = JSON.parse(stored);
      } catch (e) {}
      var userTheme = settings.theme || 'system';

      function applyTheme(theme) {
        if (theme === 'system') {
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
        } else {
          document.documentElement.setAttribute('data-theme', theme);
        }
      }

      applyTheme(userTheme);

      // Listen for system theme changes (only applies when theme is 'system')
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
        var s = {};
        try {
          var st = localStorage.getItem('retrofeed_settings');
          if (st) s = JSON.parse(st);
        } catch (err) {}
        if ((s.theme || 'system') === 'system') {
          document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
        }
      });
    })();
  <% end %>

  <%= yield :head %>

  <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
  <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

  <%#
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png"> %>
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
  <link rel="manifest" href="/favicon/site.webmanifest">
  <link rel="icon" href="/favicon/favicon.ico" sizes="any">
  <%# <link rel="icon" type="image/svg+xml" href="/retrofeed_logo.svg"> %>

  <%# Includes all stylesheet files in app/assets/stylesheets %>
  <%= stylesheet_link_tag :app, media: "all", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
