<%# Article Results - Display article extraction results to test the parser capabilities %>
<div class="min-h-screen bg-base-200 p-4 sm:p-8">
  <div class="max-w-4xl mx-auto">
    <%= link_to playground_path, class: "btn btn-ghost btn-sm gap-1 mb-4" do %>
      <%= icon_tag "arrow-left", class: "w-4 h-4" %>
      Back
    <% end %>
    <h1 class="text-2xl font-bold">Article Test Results</h1>

    <div class="mt-3 card bg-base-100 shadow-sm">
      <div class="card-body">
        <% if @results[:errors].any? %>
          <h2 class="card-title">Errors</h2>
          <div class="alert alert-error">
            <%= @results[:errors].map { |e| 
              "[#{e[:type]}] #{e[:message]}"
            }.join(" ") %>
          </div>
        <% else %>
          <h2 class="card-title">Articles</h2>
          <div class="overflow-x-auto">
            <div class="flex flex-col">
              <div class="flex flex-col">
                <% article = @results[:article] %>
                <% if article %>
                  <div class="flex-1 pb-4">
                    <h3 class="text-lg font-semibold">Title</h3>
                    <p class="text-sm p-2 input w-full font-mono"><%= article[:title] %></p>
                  </div>
                  <div class="flex-1 pb-4">
                    <h3 class="text-lg font-semibold">URL</h3>
                    <p class="text-sm p-2 input w-full font-mono"><%= article[:url] %></p>
                  </div>
                  <div class="flex-1 pb-4">
                    <h3 class="text-lg font-semibold">Published</h3>
                    <p class="text-sm p-2 input w-full font-mono"><%= article[:published] %></p>
                  </div>
                  <div class="flex-1 pb-4">
                    <h3 class="text-lg font-semibold">Author</h3>
                    <p class="text-sm p-2 input w-full font-mono"><%= article[:author] %></p>
                  </div>
                  <div class="flex-1 pb-4">
                    <h3 class="text-lg font-semibold">Word Count</h3>
                    <p class="text-sm p-2 input w-full font-mono"><%= article[:word_count] %></p>
                  </div>
                  <div class="flex-1">
                    <h3 class="text-lg font-semibold">Content</h3>
                    <textarea class="textarea textarea-bordered w-full font-mono" rows="50" readonly>
                      <%= article[:content_md] %>
                    </textarea>
                  </div>
                <% else %>
                  <p class="text-center text-gray-500">No article extracted</p>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
