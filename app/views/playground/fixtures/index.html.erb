<%# Playground Fixtures - List and manage cached HTML fixtures %>
<div class="min-h-screen bg-base-200 p-4 sm:p-8">
  <div class="max-w-4xl mx-auto">
    <%# Header with back link %>
    <div class="mb-6">
      <a href="<%= playground_path %>" class="btn btn-ghost btn-sm gap-1 mb-4">
        <%= icon_tag "arrow-left", class: "w-4 h-4" %>
        Back to Playground
      </a>
      <h1 class="text-2xl font-bold">Cached Fixtures</h1>
      <p class="text-base-content/70">
        HTML pages cached for offline testing. These are stored in <code class="text-sm bg-base-300 px-1 rounded">tmp/playground_fixtures/</code>
      </p>
    </div>

    <%# Stats Overview %>
    <div class="stats shadow mb-6 w-full">
      <div class="stat">
        <div class="stat-title">Domains</div>
        <div class="stat-value text-primary"><%= @stats[:domains] %></div>
      </div>
      <div class="stat">
        <div class="stat-title">Fixtures</div>
        <div class="stat-value"><%= @stats[:fixtures] %></div>
      </div>
      <div class="stat">
        <div class="stat-title">Total Size</div>
        <div class="stat-value text-secondary"><%= @stats[:total_size_human] %></div>
      </div>
    </div>

    <%# Domain Filter %>
    <% if @domains.any? %>
      <div class="card bg-base-100 shadow-sm mb-6">
        <div class="card-body">
          <h2 class="card-title text-lg">Filter by Domain</h2>
          <div class="flex flex-wrap gap-2">
            <a href="<%= playground_fixtures_path %>" class="btn btn-sm <%= @selected_domain.blank? ? 'btn-primary' : 'btn-ghost' %>">
              All
            </a>
            <% @domains.each do |domain| %>
              <%= link_to domain,
                  playground_fixtures_path(for_domain: domain),
                  class: "btn btn-sm #{@selected_domain == domain ? 'btn-primary' : 'btn-ghost'}" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Fixtures List %>
    <div class="card bg-base-100 shadow-sm mb-6">
      <div class="card-body">
        <div class="flex items-center justify-between mb-4">
          <h2 class="card-title text-lg">
            <% if @selected_domain %>
              Fixtures for <%= @selected_domain %>
            <% else %>
              All Fixtures
            <% end %>
          </h2>

          <% if @fixtures.any? %>
            <%= button_to destroy_all_playground_fixtures_path(domain: @selected_domain),
                method: :delete,
                class: "btn btn-ghost btn-sm btn-error",
                data: { confirm: @selected_domain ? "Clear all fixtures for #{@selected_domain}?" : "Clear ALL cached fixtures?" } do %>
              Clear <%= @selected_domain ? "Domain" : "All" %>
            <% end %>
          <% end %>
        </div>

        <% if @fixtures.any? %>
          <div class="overflow-x-auto">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Domain</th>
                  <th>URL</th>
                  <th>Cached</th>
                  <th>Size</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% @fixtures.each do |fixture| %>
                  <tr>
                    <td>
                      <span class="badge badge-ghost"><%= fixture[:domain] %></span>
                    </td>
                    <td>
                      <% if fixture[:url] %>
                        <a href="<%= fixture[:url] %>" target="_blank" class="link link-primary text-sm break-all">
                          <%= truncate(fixture[:url], length: 50) %>
                        </a>
                      <% else %>
                        <span class="text-base-content/50 text-sm"><%= fixture[:filename] %></span>
                      <% end %>
                    </td>
                    <td class="text-sm text-base-content/70">
                      <% if fixture[:fetched_at] %>
                        <%= time_ago_in_words(Time.parse(fixture[:fetched_at])) rescue fixture[:fetched_at] %> ago
                      <% else %>
                        -
                      <% end %>
                    </td>
                    <td class="text-sm text-base-content/70">
                      <%= number_to_human_size(fixture[:file_size]) %>
                    </td>
                    <td>
                      <% if fixture[:url] %>
                        <%= button_to destroy_all_playground_fixtures_path(url: fixture[:url]),
                            method: :delete,
                            class: "btn btn-ghost btn-xs btn-error",
                            data: { confirm: "Delete this fixture?" } do %>
                          Delete
                        <% end %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-base-content/70 text-center py-8">
            No cached fixtures yet. Run a test to start caching pages.
          </p>
        <% end %>
      </div>
    </div>

    <%# Actions %>
    <div class="flex gap-2">
      <a href="<%= playground_path %>" class="btn btn-primary">
        Test a Website
      </a>
    </div>
  </div>
</div>
