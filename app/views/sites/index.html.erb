<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-preview">
<% end %>

<!-- Sites list page -->
<!-- Main content -->
<main class="flex-1 flex flex-col min-w-0 h-full">
  <!-- Header -->
  <%= render PageHeaderComponent.new(
    back_path: root_path,
    title: "Websites",
    size: :small
  ) %>

  <!-- Content -->
  <div class="flex-1 overflow-y-auto">
    <div id="main-content-body">
      <%= render "sites/list",
        current_user: current_user,
        new_counts_by_website: @new_counts_by_website,
        read_counts_by_website: @read_counts_by_website,
        total_counts_by_website: @total_counts_by_website,
        progress_by_website: @progress_by_website %>
    </div>
  </div>
</main>
