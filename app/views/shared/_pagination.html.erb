<%# Reusable pagination component %>
<% current_page ||= 1 %>
<% total_pages  ||= 0 %>
<% total_count  ||= 0 %>
<% base_params  ||= {} %>
<% base_path    ||= request.path %>
<% per_page     ||= pagination_per_page %>

<% prev_page = current_page - 1 %>
<% next_page = current_page + 1 %>

<%
  # Helper to build pagination URL
  params_with_per_page = base_params.merge(per_page:)
  pagination_url = ->(page_num) { "#{base_path}?#{params_with_per_page.merge(page: page_num).to_query}" }

  # Helper to calculate which page numbers to show on mobile
  # Returns an array of page numbers and :ellipsis symbols
  mobile_page_numbers = lambda do
    return (1..total_pages).to_a if total_pages <= 5

    pages = []

    # Always include first page
    pages << 1

    # Calculate the range around current page
    range_start = [current_page - 1, 2].max
    range_end = [current_page + 1, total_pages - 1].min

    # Add ellipsis if there's a gap after page 1
    if range_start > 2
      pages << :ellipsis
    elsif range_start == 2
      pages << 2
    end

    # Add pages around current
    (range_start..range_end).each do |p|
      pages << p unless pages.include?(p)
    end

    # Add ellipsis if there's a gap before last page
    if range_end < total_pages - 1
      pages << :ellipsis
    end

    # Always include last page
    pages << total_pages unless pages.include?(total_pages)

    pages
  end
%>

<div class="flex items-center justify-between mt-6 gap-3">
  <%# Per page selector - hidden on mobile %>
  <div class="hidden sm:flex items-center gap-2">
    <%= form_with url: base_path, method: :get, local: true, html: { class: "flex items-center gap-2" } do |f| %>
      <% base_params.each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <%= hidden_field_tag :page, 1 %>

      <span class="text-xs text-base-content/60 whitespace-nowrap">Per page</span>
      <%= select_tag :per_page,
        options_for_select([10, 20, 50, 100], per_page),
        class: "select select-xs",
        data: {
          controller: "form-submit",
          action: "change->form-submit#submit"
        }
      %>

      <button type="submit" class="hidden">Go</button>
    <% end %>
  </div>

  <%# Mobile pagination - visible only on mobile %>
  <div class="flex sm:hidden items-center justify-center gap-1 w-full">
    <%# Previous page arrow - hidden on first page %>
    <% if current_page > 1 %>
      <a href="<%= pagination_url.call(prev_page) %>" aria-label="Previous page" class="btn btn-ghost btn-sm btn-square">
        <%= icon_tag "arrow-left" %>
      </a>
    <% end %>

    <%# Page number buttons %>
    <% mobile_page_numbers.call.each do |page_item| %>
      <% if page_item == :ellipsis %>
        <span class="px-1 text-base-content/40">...</span>
      <% else %>
        <% is_active = page_item == current_page %>
        <% if is_active %>
          <span aria-label="Page <%= page_item %>" aria-current="page" class="btn btn-ghost btn-sm btn-square"><%= page_item %></span>
        <% else %>
          <a href="<%= pagination_url.call(page_item) %>" aria-label="Page <%= page_item %>" class="btn btn-ghost btn-sm btn-square"><%= page_item %></a>
        <% end %>
      <% end %>
    <% end %>

    <%# Next page arrow - hidden on last page %>
    <% if current_page < total_pages %>
      <a href="<%= pagination_url.call(next_page) %>" aria-label="Next page" class="btn btn-ghost btn-sm btn-square">
        <%= icon_tag "arrow-right" %>
      </a>
    <% end %>
  </div>

  <%# Desktop pagination - hidden on mobile %>
  <div class="hidden sm:flex items-center gap-2 min-w-0">

    <%# Previous page %>
    <% if prev_page >= 1 %>
      <a href="<%= pagination_url.call(prev_page) %>" aria-label="Previous page" class="btn btn-ghost btn-sm btn-square">
        <%= icon_tag "arrow-left" %>
      </a>
    <% end %>

    <%= form_with url: base_path, method: :get, local: true, html: { class: "flex items-center gap-2" } do |f| %>
      <% base_params.each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <%= hidden_field_tag :per_page, per_page %>

      <%# Page input %>
      <%= render InputComponent.new(
        type: :number,
        name: "page",
        value: current_page,
        min: 1,
        max: total_pages,
        size: :xs,
        class: "w-12 text-center"
      ) %>
      <span class="text-xs text-base-content/60 whitespace-nowrap">of <%= total_pages %></span>
      <button type="submit" class="hidden">Go</button>
    <% end %>

    <%# Next page %>
    <% if next_page <= total_pages %>
      <a href="<%= pagination_url.call(next_page) %>" aria-label="Next page" class="btn btn-ghost btn-sm btn-square">
        <%= icon_tag "arrow-right" %>
      </a>
    <% end %>
  </div>
</div>
