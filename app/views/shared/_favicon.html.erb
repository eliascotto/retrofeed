<%# Reusable favicon component with fallback to initials %>
<%
  favicon = local_assigns[:favicon]
  use_letter_fallback = local_assigns[:use_letter_fallback] || false
%>
<div class="shrink-0 w-6 h-6 flex items-center justify-center">
  <% if favicon.present? && use_letter_fallback == false %>
    <%= image_tag favicon, alt: "", class: "w-6 h-6 object-contain rounded" %>
  <% else %>
    <div class="w-6 h-6 rounded bg-base-200 flex items-center justify-center">
      <span class="text-[10px] font-medium text-base-content/50"><%= (favicon || " ")[0].upcase %></span>
    </div>
  <% end %>
</div>
