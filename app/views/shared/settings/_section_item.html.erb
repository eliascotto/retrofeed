<%# Settings section list item component
  Usage: render "shared/settings/section_item", title: "Account", icon: "user", path: settings_account_path
%>
<%= link_to path, class: "flex items-center justify-between px-4 py-4 hover:bg-base-200 dark:hover:bg-base-200 cursor-default" do %>
  <div class="flex items-center gap-3">
    <%= icon_tag icon, class: "w-5 h-5" %>
    <span class="text-sm"><%= local_assigns[:title] %></span>
  </div>
  <%= icon_tag "chevron-right", class: "w-4 h-4 text-base-content/50" %>
<% end %>
