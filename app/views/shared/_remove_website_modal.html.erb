<%# Confirmation modal for removing a website %>
<%# Usage: render "shared/remove_website_modal" %>

<dialog
  id="remove-website-modal"
  class="modal"
  data-controller="remove-website-modal"
  data-action="modal:openRemoveWebsite@window->remove-website-modal#openFromEvent"
  data-remove-website-modal-csrf-token-value="<%= form_authenticity_token %>"
>
  <div class="modal-box">
    <!-- Header with close button -->
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-bold text-lg">Remove Website</h3>
      <form method="dialog">
        <button
          class="btn btn-sm btn-circle btn-ghost shadow-none text-base text-base-content/50 hover:text-white"
          data-action="click->remove-website-modal#close"
        >
          <%= icon_tag "x", class: "w-5 h-5" %>
        </button>
      </form>
    </div>

    <!-- Message -->
    <p class="text-base-content/70 mb-6">
      Are you sure you want to remove <span class="font-semibold text-base-content" data-remove-website-modal-target="websiteName"></span>? This will unsubscribe you from this website.
    </p>

    <!-- Actions -->
    <div class="modal-action mt-0">
      <button
        type="button"
        class="btn btn-ghost"
        data-action="click->remove-website-modal#close"
      >
        Cancel
      </button>
      <button
        type="button"
        class="btn btn-error"
        data-action="click->remove-website-modal#confirm"
      >
        Remove
      </button>
    </div>
  </div>

  <!-- Backdrop click to close -->
  <form method="dialog" class="modal-backdrop">
    <button data-action="click->remove-website-modal#close">close</button>
  </form>
</dialog>
