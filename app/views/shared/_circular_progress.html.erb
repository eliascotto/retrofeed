<% 
  percentage = local_assigns[:percentage] || 0
  size = local_assigns[:size] || 20
  stroke_width = local_assigns[:stroke_width] || 2
  radius = (size - stroke_width) / 2
  circumference = 2 * Math::PI * radius
  offset = circumference - (percentage / 100.0) * circumference
%>
<svg width="<%= size %>" height="<%= size %>" class="circular-progress <%= local_assigns[:class] %>" data-percentage="<%= percentage %>">
  <!-- Background circle -->
  <circle
    cx="<%= size / 2 %>"
    cy="<%= size / 2 %>"
    r="<%= radius %>"
    fill="none"
    stroke="currentColor"
    stroke-width="<%= stroke_width %>"
    class="text-base-300 dark:text-primary/50"
    opacity="0.3"
  />
  <!-- Progress circle -->
  <circle
    cx="<%= size / 2 %>"
    cy="<%= size / 2 %>"
    r="<%= radius %>"
    fill="none"
    stroke="currentColor"
    stroke-width="<%= stroke_width %>"
    class="progress text-base-content/60 dark:text-primary"
    stroke-dasharray="<%= circumference %>"
    stroke-dashoffset="<%= offset %>"
    stroke-linecap="round"
    transform="rotate(-90 <%= size / 2 %> <%= size / 2 %>)"
    style="transition: stroke-dashoffset 0.3s ease;"
  />
</svg>
