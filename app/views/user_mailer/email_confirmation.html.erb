<div class="content">
  <p>Hey there!</p>

  <p>Thanks for signing up for RetroFeed. Please confirm your email address by clicking the button below:</p>

  <p style="text-align: center; margin: 30px 0;">
    <a href="<%= @confirmation_url %>" class="button" style="color: white;">Confirm Email Address</a>
  </p>

  <p class="muted">
    This link will expire in <%= @expires_in.inspect %>. If you didn't create an account with RetroFeed, you can safely ignore this email.
  </p>

  <p class="muted">
    If the button doesn't work, copy and paste this link into your browser:<br>
    <a href="<%= @confirmation_url %>" style="word-break: break-all;"><%= @confirmation_url %></a>
  </p>
</div>

<div class="footer">
  <h3>RetroFeed</h3>
</div>
