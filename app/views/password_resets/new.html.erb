<!-- Password reset page -->
<% footer = capture do %>
  <div class="mt-5 text-center text-sm">
    <%= link_to "Go back to Login", new_session_path, class: "link link-hover underline text-base-content" %>
  </div>
<% end %>

<%= render "shared/auth_card", title: "Forgot your password?", footer: footer do %>
  <p>
    Enter your email address below and we’ll send you password reset instructions.
  </p>

  <% if flash[:notice].present? %>
    <div class="p-3 mt-4 rounded-lg bg-primary/80">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <%= form_with url: password_reset_path,
    class: "mt-4",
    method: :post, local: true, data: { turbo: false } do |f| %>
    <%= render partial: "shared/auth_field",
      locals: {
        form: f,
        field: :email,
        type: :email,
        required: true,
        autofocus: true,
        placeholder: "your@email.com"
      } %>

    <%= render partial: "shared/auth_submit_button", locals: { text: "Reset password" } %>
  <% end %>

  <p class="mt-4">
    If you don’t see your reset email be sure to <b>check your spam folder</b>.
  </p>
<% end %>
