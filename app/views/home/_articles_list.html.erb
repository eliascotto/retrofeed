<!-- Articles List -->
<% articles ||= @articles %>
<% tab ||= @tab || "recent" %>
<% read_next_article_ids ||= @read_next_article_ids || Set.new %>
<div id="articles-list-container" class="p-4">
  <!-- Articles present -->
  <% if articles.present? && articles.respond_to?(:any?) && articles.any? %>
    <div id="articles-list" class="space-y-1">
      <% articles.each do |article| %>
        <% in_read_next = read_next_article_ids.include?(article.id) %>
        <%= render ::ArticleItem::Component.new(
          current_user: current_user,
          article: article,
          is_read: false,
          read_at: nil,
          in_read_next: in_read_next,
          show_website: true,
          show_favicon: true
        ) %>
      <% end %>
    </div>

  <% else %>
    <!-- Empty state -->
    <div class="flex flex-col items-center justify-center py-12">
      <div class="w-12 h-12 mb-4 rounded-full bg-base-200 dark:bg-base-200 flex items-center justify-center">
        <%= icon_tag "file", class: "w-5 h-5 text-base-content/40" %>
      </div>
      <% if tab == "reading" %>
        <h3 class="text-base font-medium text-base-content mb-1">No articles in progress</h3>
        <p class="text-sm text-base-content/50 text-center max-w-xs">
          Articles you open will appear here until you finish reading them.
        </p>
      <% else %>
        <h3 class="text-base font-medium text-base-content mb-1">No unread articles</h3>
        <p class="text-sm text-base-content/50 text-center max-w-xs mb-6">
          Add websites to start reading articles.
        </p>
        <button
            class="btn btn-primary btn-sm"
            data-controller="modal-trigger"
            data-action="click->modal-trigger#open"
            data-modal-trigger-event-value="openAddWebsite"
        >
          <%= icon_tag "plus", class: "text-base" %>
          Add your first site
        </button>
      <% end %>
    </div>
  <% end %>
</div>
