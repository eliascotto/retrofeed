<main class="flex-1 flex flex-col min-w-0 h-full">
  <%= render PageHeaderComponent.new(title: "Appearance", back_path: settings_path, size: :small) %>

  <div class="flex-1 overflow-y-auto">
    <div class="mx-auto px-4 py-6" data-controller="theme-settings">
      <div class="space-y-6">
        <div class="space-y-3">
          <div class="flex items-center gap-2 text-base-content/70">
            <%= icon_tag "smartphone", class: "w-5 h-5" %>
            <span class="font-medium">Color mode</span>
          </div>
          <%= render SegmentedControlComponent.new(
            name: "theme",
            options: [
              { value: "system", label: "System" },
              { value: "light", label: "Light" },
              { value: "dark", label: "Dark" }
            ],
            selected: "system",
            full_width: true,
            data: {
              theme_settings_target: "control",
              action: "change->theme-settings#setTheme"
            }
          ) %>
        </div>
      </div>
    </div>
  </div>
</main>
