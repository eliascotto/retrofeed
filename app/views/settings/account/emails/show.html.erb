<main class="flex-1 flex flex-col min-w-0 h-full">
  <%= render PageHeaderComponent.new(title: "Email", back_path: settings_account_path, size: :small) %>

  <div class="flex-1 overflow-y-auto">
    <div class="mx-auto px-4 py-6">
      <%= form_with model: @user, url: settings_account_email_path, method: :patch, local: true, class: "space-y-6" do |f| %>
        <% if @user.errors.any? %>
          <div class="alert alert-error">
            <ul class="list-disc list-inside">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if @user.unconfirmed_email? %>
          <div class="alert alert-info">
            <p>A confirmation email was sent to <strong><%= @user.unconfirmed_email %></strong>. Please click the link in that email to complete the change.</p>
          </div>
        <% end %>

        <div>
          <div class="label">
            <span class="label-text">Email</span>
          </div>
          <%= render InputComponent.new(
            type: :email,
            name: "user[email]",
            value: @user.email,
            variant: :bordered,
            required: true,
            placeholder: "your@email.com",
            class: "w-full"
          ) %>
          <div class="label">
            <span class="label-text-alt text-base-content/60 dark:text-base-content/60">Your email address</span>
          </div>
        </div>

        <div class="">
          <button type="submit" class="btn btn-primary btn-block">Update Email</button>
        </div>
      <% end %>
    </div>
  </div>
</main>
