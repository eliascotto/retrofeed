<main class="flex-1 flex flex-col min-w-0 h-full">
  <%= render PageHeaderComponent.new(title: "Account", back_path: settings_path, size: :small) %>

  <div class="flex-1 overflow-y-auto">
    <div class="mx-auto">
      <%= render "shared/settings/subsection_item",
        title: "Email",
        icon: "mail",
        path: settings_account_email_path,
        value: @user.email %>

      <%= render "shared/settings/subsection_item",
        title: "Handle",
        icon: "at-sign",
        path: settings_account_handle_path,
        value: @user.handle.present? ? "@#{@user.handle}" : "Not set" %>

      <%= render "shared/settings/subsection_item",
        title: "Password",
        icon: "lock",
        path: settings_account_password_path %>
    </div>
  </div>
</main>
