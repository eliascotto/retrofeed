#!/usr/bin/env ruby
require "open3"
require "tmpdir"
require_relative "../lib/release_security"

abort("Usage: bin/scan-secrets [--history]") unless ARGV.empty?() || ARGV == [ "--history" ]

Dir.chdir(File.expand_path("..", __dir__)) do
  paths, status = Open3.capture2("git", "ls-files", "--cached", "-z")
  abort("Cannot inspect tracked files") unless status.success?()
  tracked_paths = paths.split("\0")
  checked_paths = tracked_paths

  if ARGV.include?("--history")
    history, status = Open3.capture2("git", "log", "--all", "--format=", "--name-only", "--no-renames", "--no-textconv", "-z")
    abort("Cannot inspect Git history") unless status.success?()
    checked_paths += history.split("\0").map(&:strip).reject(&:empty?)
  end

  private_paths = checked_paths.uniq().select { |path| ReleaseSecurity.private_path?(path) }
  unless private_paths.empty?()
    warn "Private release files found (filenames only):"
    private_paths.sort().each { |path| warn "  #{path}" }
    abort("Remove these files from the index and, when applicable, Git history.")
  end

  unless system("gitleaks", "version", out: File::NULL, err: File::NULL)
    abort("Install Gitleaks 8.30.1 or newer, then run this check again.")
  end

  config = File.expand_path(".gitleaks.toml")
  # Scan the index so unstaged edits cannot hide secrets in the next commit.
  # Ignored local credentials are deliberately excluded from this snapshot.
  Dir.mktmpdir("retrofeed-release-scan-") do |directory|
    unless system("git", "checkout-index", "--all", "--prefix=#{directory}/")
      abort("Cannot export the Git index for scanning.")
    end
    unless system("gitleaks", "dir", "--config", config, "--redact=100", "--no-banner", directory)
      abort("Release file secret scan failed.")
    end
  end

  if ARGV.include?("--history")
    # Disabling text conversion prevents Git from decrypting credentials while scanning.
    unless system("gitleaks", "git", "--config", config, "--redact=100", "--no-banner", "--log-opts=--all --no-textconv", ".")
      abort("Git history secret scan failed.")
    end
  end

  puts "Release secret checks passed."
end
