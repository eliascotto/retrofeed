#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  # ================================
  # Node
  # ================================

  puts "== Installing Node dependencies =="
  if not File.directory?("node_modules")
    puts "Installing Node modules..."
    system("npm install") || abort("npm install failed")
    puts "Installing playwright dependencies..."
    system("npx playwright install") || abort("npx playwright install failed")
  else
    puts "Node modules already installed"
  end

  # ================================
  # Defuddle
  # ================================

  puts "== Veryfying external dependencies =="
  if not File.directory?("tools/defuddle")
    puts "tools/defuddle folder not found"
    puts "Cloning defuddle repository..."
    system("git clone git@github.com:kepano/defuddle.git tools/defuddle") || abort("git clone failed for defuddle")
  end


  puts "== Building external dependencies =="
  Dir.chdir("tools/defuddle") do
    system("npm install") || abort("npm install failed for defuddle")
    system("npm run build") || abort("npm run build failed for defuddle")
  end

  # ================================
  # Rails
  # ================================

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")
  
  puts "== Installing node dependencies =="
  system("npm install") || abort("npm install failed for node dependencies")

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  # Optionally download test fixtures from separate repository
  if ARGV.include?("--with-fixtures")
    puts "\n== Downloading test fixtures =="
    puts "This may take a moment..."
    system! "bin/rake fixtures:download"
  else
    websites_path = File.join(APP_ROOT, "test", "fixtures", "websites")
    unless File.exist?(websites_path) && Dir.children(websites_path).any?
      puts "\n== Test fixtures =="
      puts "HTML fixtures are stored in a separate repository."
      puts "To download them, run: bin/rake fixtures:download"
      puts "Or run setup with: bin/setup --with-fixtures"
    end
  end

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
