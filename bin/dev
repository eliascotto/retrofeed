#!/usr/bin/env sh

PORT=3006

# Default to port 3006 if not specified (avoids conflict with other apps on 3000)
export PORT="${PORT:-3006}"

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

# Unset DATABASE_URL in development (only used in production)
unset DATABASE_URL

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

exec foreman start -f Procfile.dev "$@"

echo "Login with admin@retrofeed.com/password123 to: http://retrofeed.localhost:$PORT/"
