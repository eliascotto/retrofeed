# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore environment files. Keep .env.example
.env
.env.*
!.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore key files for decrypting credentials and more.
*.key*
*.pem
*.p12
*.pfx
*.bak
/config/credentials/*.yml


/app/assets/builds/*
!/app/assets/builds/.keep

# Node
node_modules/

# Editor
.vscode/
.cursor/
.zed/
.claude/
*.vim

# Test fixtures - HTML/JSON website fixtures are in separate repo
/test/fixtures/websites/

# Internal defuddle is a separate repo
/tools/defuddle/

# Script cache
/script/__pycache__/

# Playwright
/playwright-report/
/test-results/

# Kamal
.kamal/secrets*

# DS_Store
**/.DS_Store

# Ruby LSP
.ruby-lsp
