namespace :docs do
  desc "Generate task documentation to docs/tasks.md"
  task generate_tasks: :environment do
    task_files = Dir[Rails.root.join("lib/tasks/**/*.rake")]

    namespaces = task_files.map do |file|
      File.basename(file, ".rake")
    end

    tasks_by_namespace = namespaces.each_with_object({}) do |ns, hash|
      matching_tasks = Rake.application.tasks.select do |task|
        task.comment.present? && task.name.start_with?("#{ns}:")
      end
      hash[ns] = matching_tasks if matching_tasks.any?
    end

    rows = tasks_by_namespace.flat_map do |ns, tasks|
      tasks.map { |task| "| `#{task.name}` | #{task.comment} |" }
    end

    content = <<~MARKDOWN
# Rake Tasks

This file is automatically generated. To regenerate it, run:
```bash
rails docs:generate_tasks
```

| Task | Description |
|------|-------------|
#{rows.join("\n")}
    MARKDOWN

    FileUtils.mkdir_p(Rails.root.join("docs"))
    File.write(Rails.root.join("docs/tasks.md"), content)

    puts "Generated docs/tasks.md with #{rows.count} tasks"
  end
end
