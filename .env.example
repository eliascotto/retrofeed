# WebProcessor Configuration
# See config/initializers/web_processor.rb for details

# Kamal Registry
KAMAL_IMAGE=ghcr.io/your-account/retrofeed
KAMAL_REGISTRY_USERNAME=your-account
KAMAL_REGISTRY_PASSWORD=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Deployment server and private SSH key path
DEPLOY_SERVER=192.0.2.1
DEPLOY_SSH_KEY=~/.ssh/your-deployment-key

# Rails: use config/credentials/production.key, never a development key
RAILS_MASTER_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# PostgreSQL
POSTGRES_USER=retrofeed
POSTGRES_PASSWORD='my_db_password'
POSTGRES_DB=my_db_name
DATABASE_URL=postgresql://retrofeed:my_db_password@retrofeed-db:5432/my_db_name

# === Website Archive Crawling ===
# Full archive re-crawl to discover new articles (default: 14 days)
WEBSITE_ARCHIVE_INTERVAL=5 days
# Hard minimum between website re-crawls for manual refresh (default: 60 minutes, floor: 10 minutes)
WEBSITE_ARCHIVE_MIN_INTERVAL=60 minutes

# === Article Content Refresh ===
# Re-check existing article content (default: 60 days)
ARTICLE_CONTENT_INTERVAL=60 days
# Hard minimum between article refreshes for manual refresh (default: 30 minutes, floor: 10 minutes)
ARTICLE_CONTENT_MIN_INTERVAL=30 minutes

# Enable article content fetching (default: false)
# ARTICLE_CONTENT_FETCHING_ENABLED=false

# Enable webdata mocking in pipelines
# MOCK_WEB_DATA=true

# To log output to both files and STDOUT
# LOG_TO_FILE=1

# To enable Resend email sending
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Email address for sending noreply emails
MAILER_FROM_EMAIL=noreply@retrofeed.app

# Current app host address
APP_HOST=reader.example.com

# Use browser fetcher for web requests
USE_BROWSER_FETCHER=true

# Enable seed with generated articles
SEED_GENERATED_ARTICLES=true
